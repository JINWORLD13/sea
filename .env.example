# Proxy server (server/proxy.js) — server-side only, never prefix with VITE_
# (the proxy deliberately does NOT read VITE_AISSTREAM_API_KEY)
AISSTREAM_API_KEY=

# Local ports — leave unset to use 8080 on both sides. If 8080 is taken,
# set BOTH to the same free port (the client reads VITE_PROXY_PORT).
# PROXY_PORT=8081
# VITE_PROXY_PORT=8081

# Production hardening (proxy): comma-separated Origin allowlist for the
# WebSocket/HTTP endpoints. Empty = allow all (fine for local dev).
# ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Frontend build-time overrides — set these when the proxy runs on a
# different host than the frontend (e.g. Vercel frontend + Render proxy).
# Leave unset for local dev (defaults to window.location.hostname:8080).
VITE_PROXY_WS_URL=
VITE_PROXY_HTTP_URL=
